---
import Base from '../layouts/Base.astro';
import { getLessons, getCards } from '../data/course';

const lessons = await getLessons();
const pool = (await Promise.all(lessons.map((l) => getCards(l.id, l.short)))).flat();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="ফাইনাল পরীক্ষা" nav="exam" description="পুরো Rust কোর্স থেকে ৩০টা প্রশ্ন। ৭০% পেলে নিজের নামে সার্টিফিকেট।">
  <section class="narrow" style="text-align:center;padding:40px 0" id="intro">
    <div style="font-size:90px;line-height:1">🎓</div>
    <h1 class="page-title">ফাইনাল পরীক্ষা</h1>
    <p class="muted" style="font-size:18px">পুরো কোর্সের ৪০টা পাঠ থেকে এলোমেলো ৩০টা প্রশ্ন আসবে।</p>
    <div class="panel" style="text-align:left;margin:24px 0">
      <ul style="margin:0">
        <li>প্রতিটা প্রশ্ন একবারই আসবে</li>
        <li><b>২১/৩০ (৭০%)</b> পেলে পাশ, তখন নিজের নামে <b>সার্টিফিকেট</b> পাবে, প্রিন্ট বা PDF করা যায়</li>
        <li>প্রথমবার পাশ করলে <b>+২০০ XP</b> আর 👑 Rustacean ব্যাজ</li>
      </ul>
      <label style="display:block;margin-top:16px">সার্টিফিকেটে তোমার নাম:
        <input id="name" maxlength="40" placeholder="তোমার নাম লেখো" style="display:block;width:100%;margin-top:6px;padding:12px 14px;border-radius:12px;border:2px solid var(--line);background:var(--bg2);color:var(--text);font:600 18px var(--font)" />
      </label>
    </div>
    <p class="muted" id="best"></p>
    <button class="btn" id="go" style="font-size:20px;padding:14px 34px">📝 পরীক্ষা শুরু করো</button>
  </section>
  <section class="narrow" id="cert-wrap" hidden>
    <div class="cert" id="cert">
      <img src={base + 'logo-mark-256.png'} alt="" />
      <div style="letter-spacing:3px;font-weight:600;margin-top:8px">RUST বাংলা</div>
      <h2>সার্টিফিকেট</h2>
      <div>এই মর্মে প্রত্যয়ন করা যাচ্ছে যে</div>
      <div class="name" id="cert-name"></div>
      <div>Rust বাংলা কোর্সের ফাইনাল পরীক্ষায় <b id="cert-score"></b> নম্বর পেয়ে সফলভাবে উত্তীর্ণ হয়েছেন।</div>
      <div style="margin-top:18px;font-size:14px">তারিখ: <span id="cert-date"></span> · Rust বাংলা (YouTube: @RustBangla)</div>
    </div>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <button class="btn" onclick="window.print()">🖨️ প্রিন্ট / PDF</button>
      <a class="btn ghost" href={base}>🗺️ রোডম্যাপ</a>
    </div>
  </section>
  <div class="quiz-layer" id="layer" hidden></div>
  <script is:inline type="application/json" id="exam-data" set:html={JSON.stringify({ pool, home: base }).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { runQuiz, md } from '../scripts/quiz';
  import { load, save, gain, bn } from '../scripts/store';
  import { confetti, sound, announceBadges } from '../scripts/ui';

  const data = JSON.parse(document.getElementById('exam-data')!.textContent!);
  const layer = document.getElementById('layer')!;
  const nameEl = document.getElementById('name') as HTMLInputElement;
  const s0 = load();
  if (s0.exam?.name) nameEl.value = s0.exam.name;

  function showCert() {
    const s = load();
    if (!s.exam || s.exam.score / s.exam.total < 0.7) return;
    document.getElementById('cert-wrap')!.hidden = false;
    document.getElementById('cert-name')!.textContent = s.exam.name || 'Rust শিক্ষার্থী';
    document.getElementById('cert-score')!.textContent = `${bn(s.exam.score)}/${bn(s.exam.total)}`;
    document.getElementById('cert-date')!.textContent = new Date(s.exam.at).toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' });
    document.getElementById('best')!.textContent = `তুমি আগেই পাশ করেছো (${bn(s.exam.score)}/${bn(s.exam.total)})। চাইলে আবার দিতে পারো।`;
  }
  showCert();

  function pick() {
    const a = [...data.pool];
    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    return a.slice(0, 30);
  }

  document.getElementById('go')!.addEventListener('click', () => {
    layer.hidden = false;
    document.body.style.overflow = 'hidden';
    runQuiz(layer, pick(), {
      requeue: false,
      onClose: () => { if (confirm('পরীক্ষা ছেড়ে যাবে?')) { layer.hidden = true; document.body.style.overflow = ''; } },
      onFinish: ({ firstTry, total, missed }) => {
        const s = load();
        const pass = firstTry / total >= 0.7;
        const firstPass = pass && !(s.exam && s.exam.score / s.exam.total >= 0.7);
        if (!s.exam || firstTry >= s.exam.score) s.exam = { score: firstTry, total, name: nameEl.value.trim(), at: new Date().toISOString() };
        const nb = gain(s, firstPass ? 200 : 0);
        save(s);
        if (pass) { sound('win'); confetti(200); } else sound('bad');
        announceBadges(nb);
        layer.innerHTML = `<div class="qz"><div class="result">
          <div class="big">${pass ? '🎓' : '📚'}</div>
          <h2>${pass ? 'অভিনন্দন! তুমি পাশ করেছো!' : 'এবার হলো না, আবার চেষ্টা করো'}</h2>
          <div class="grid">
            <div><b>${bn(firstTry)}/${bn(total)}</b><small>ঠিক উত্তর</small></div>
            <div><b>${bn(Math.round((firstTry / total) * 100))}%</b><small>স্কোর</small></div>
            <div><b>⚡ +${bn(firstPass ? 200 : 0)}</b><small>XP</small></div>
          </div>
          ${missed.length ? `<div class="missed panel"><h3>📝 যেগুলো ভুল হয়েছে</h3><ul>${missed.map((c) => `<li><b>${md(c.q)}</b> <small>(${md(c.from || '')})</small><br>${md(c.explain)}</li>`).join('')}</ul></div>` : ''}
          <div class="acts">
            ${pass ? '<button class="btn" id="see">📜 সার্টিফিকেট দেখো</button>' : ''}
            <a class="btn ghost" href="${data.home}#board">🗺️ রোডম্যাপ</a>
          </div></div></div>`;
        layer.scrollTop = 0;
        const see = document.getElementById('see');
        if (see) see.onclick = () => { layer.hidden = true; document.body.style.overflow = ''; showCert(); document.getElementById('cert-wrap')!.scrollIntoView(); };
      },
    });
  });
</script>
