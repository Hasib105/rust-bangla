---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLessons, getCards } from '../../data/course';
import { parts } from '../../data/parts';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((l, i) => ({ params: { slug: l.slug }, props: { i } }));
}
const { i } = Astro.props;
const lessons = await getLessons();
const lesson = lessons[i];
const prev = lessons[i - 1];
const next = lessons[i + 1];
const part = parts.find((p) => p.id === lesson.part)!;
const { Content } = await render(lesson.entry);
const cards = await getCards(lesson.id);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const bnN = (n: number) => String(n).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]);
const partLessons = lessons.filter((l) => l.part === lesson.part);
const lastOfPart = partLessons[partLessons.length - 1].slug === lesson.slug;
---
<Base title={lesson.title} description={lesson.summary}>
  <article class="narrow">
    <header class="lesson-head">
      <div class="crumbs">
        <a href={base}>🗺️ রোডম্যাপ</a> ›
        <a href={base + '#board'}>পর্ব {bnN(part.id)}: {part.title}</a> ›
        <span>পাঠ {bnN(lesson.order)}</span>
      </div>
      <h1>{lesson.icon} {lesson.title}</h1>
      <p class="sum">{lesson.summary}</p>
      <div class="chips">
        <span>⏱️ {bnN(lesson.minutes)} মিনিট</span>
        <span>🎮 {bnN(cards.length)}টা প্রশ্ন</span>
        <span>⚡ {bnN(cards.length * 10 + 20)} XP পর্যন্ত</span>
        <span id="done-chip" hidden>✅ শেষ করেছো</span>
      </div>
    </header>

    <div class="modes">
      <a class="mode" href="#read"><span class="ic">📖</span><span>পড়ো<br /><small>পুরো পাঠ, কোড চালিয়ে দেখো</small></span></a>
      <button class="mode play" data-start="play"><span class="ic">🎮</span><span>খেলো<br /><small>ছোট কার্ড + মাঝে মাঝে প্রশ্ন</small></span></button>
      <button class="mode" data-start="quiz"><span class="ic">⚡</span><span>শুধু কুইজ<br /><small>জানো? সরাসরি {bnN(cards.length)}টা প্রশ্ন</small></span></button>
    </div>

    {lesson.video && (
      <div class="yt" data-yt={lesson.video} role="button" tabindex="0" aria-label="ভিডিও চালাও">
        <img src={`https://i.ytimg.com/vi/${lesson.video}/hqdefault.jpg`} alt={`${lesson.title}: ভিডিও`} loading="lazy" />
        <div class="play"><span>▶ ভিডিও দেখো</span></div>
      </div>
    )}

    <div class="prose" id="read">
      <Content />
    </div>

    <section class="play-cta">
      <h2>🎮 এবার খেলার পালা!</h2>
      <p>{bnN(cards.length)}টা প্রশ্ন। প্রথমবারেই ঠিক করলে প্রতিটায় ১০ XP। ভুল করা প্রশ্ন শেষে আবার আসবে।</p>
      <div class="row">
        <button class="btn" data-start="quiz">⚡ কুইজ শুরু করো</button>
        <button class="btn ghost" data-start="play">🎮 কার্ড দিয়ে খেলো</button>
      </div>
    </section>

    <nav class="pager">
      {prev && <a class="pv" href={base + 'learn/' + prev.slug + '/'}><small>← আগের পাঠ</small>{prev.icon} {prev.short}</a>}
      {next && <a class="nx" href={base + 'learn/' + next.slug + '/'}><small>পরের পাঠ →</small>{next.icon} {next.short}</a>}
    </nav>
  </article>

  <div class="quiz-layer" id="layer" hidden></div>

  <script
    is:inline
    type="application/json"
    id="quiz-data"
    set:html={JSON.stringify({
      slug: lesson.slug,
      title: lesson.title,
      cards,
      next: next ? { href: base + 'learn/' + next.slug + '/', title: next.short } : null,
      boss: lastOfPart ? { href: base + 'boss/' + lesson.part + '/', title: `পর্ব ${bnN(lesson.part)}-এর বস লড়াই` } : null,
      home: base,
    }).replace(/</g, '\\u003c')}
  />
</Base>

<script>
  import { runQuiz, starsFor, md } from '../../scripts/quiz';
  import { load, save, gain, bn } from '../../scripts/store';
  import { confetti, sound, announceBadges, toast } from '../../scripts/ui';
  import { initRunners } from '../../scripts/runner';

  // Snapshot the lesson sections (before Run buttons are added) for Play mode's learn cards.
  const sections: { title: string; html: string }[] = [];
  {
    let cur: { title: string; nodes: Node[] } | null = null;
    const flush = () => { if (cur && cur.nodes.length) sections.push({ title: cur.title, html: cur.nodes.map((n) => (n as Element).outerHTML ?? n.textContent).join('') }); };
    for (const el of [...document.getElementById('read')!.children]) {
      if (el.tagName === 'H2') { flush(); cur = { title: el.textContent || '', nodes: [] }; }
      else if (cur) cur.nodes.push(el);
    }
    flush();
  }
  initRunners();

  // lazy YouTube
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    const go = () => {
      el.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0" title="YouTube" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    };
    el.addEventListener('click', go, { once: true });
    el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); }, { once: true });
  });

  const data = JSON.parse(document.getElementById('quiz-data')!.textContent!);
  const layer = document.getElementById('layer')!;
  if (load().lessons[data.slug]) document.getElementById('done-chip')!.hidden = false;

  function close() {
    layer.hidden = true;
    document.body.style.overflow = '';
  }

  /** Play: learn cards from the lesson sections with the quiz questions spread between them. */
  function playDeck() {
    const learn = sections.filter((x) => !/নিজে করো/.test(x.title)).map((x) => ({ type: 'learn', explain: '', q: '', ...x }));
    const qs = [...data.cards];
    const boss = qs.pop();
    const deck: any[] = [];
    learn.forEach((l, k) => {
      deck.push(l);
      const take = Math.round(((k + 1) * qs.length) / learn.length) - Math.round((k * qs.length) / learn.length);
      deck.push(...qs.splice(0, take));
    });
    deck.push(...qs);
    if (boss) deck.push(boss);
    return deck;
  }

  let lastMode = 'quiz';
  function start(mode: string = lastMode) {
    lastMode = mode;
    layer.hidden = false;
    document.body.style.overflow = 'hidden';
    runQuiz(layer, mode === 'play' ? playDeck() : data.cards, {
      requeue: true,
      onLearn: (el) => initRunners(el),
      onClose: () => { if (confirm('কুইজ ছেড়ে যাবে? অগ্রগতি সেভ হবে না।')) close(); },
      onFinish: ({ firstTry, total, missed }) => {
        const s = load();
        const old = s.lessons[data.slug];
        const stars = starsFor(firstTry, total);
        const firstTime = !old;
        // XP only for improving your best, + a bonus the first time you finish
        const xp = Math.max(0, firstTry - (old?.best ?? 0)) * 10 + (firstTime ? 20 : 0) + (stars === 3 && (old?.stars ?? 0) < 3 ? 10 : 0);
        s.lessons[data.slug] = {
          best: Math.max(firstTry, old?.best ?? 0),
          total,
          stars: Math.max(stars, old?.stars ?? 0),
          at: new Date().toISOString(),
        };
        const newBadges = gain(s, xp);
        save(s);
        sound('win');
        confetti(stars === 3 ? 140 : 70);
        announceBadges(newBadges);
        const titles = ['ভালো চেষ্টা!', 'দারুণ খেলেছো!', 'অসাধারণ! নিখুঁত!'];
        layer.innerHTML = `
          <div class="qz"><div class="result">
            <div class="big">${stars === 3 ? '🏆' : stars === 2 ? '🎉' : '💪'}</div>
            <h2>${titles[stars - 1]}</h2>
            <div class="stars-big">${[1, 2, 3].map((k) => `<span class="${k <= stars ? '' : 'off'}">⭐</span>`).join('')}</div>
            <div class="grid">
              <div><b>⚡ +${bn(xp)}</b><small>XP পেলে</small></div>
              <div><b>${bn(firstTry)}/${bn(total)}</b><small>প্রথমবারেই ঠিক</small></div>
              <div><b>🔥 ${bn(s.streak.count)}</b><small>দিনের স্ট্রিক</small></div>
            </div>
            ${xp === 0 && !firstTime ? '<p class="muted">আগের সেরা স্কোর ছাড়াতে পারলে নতুন XP পাবে।</p>' : ''}
            ${missed.length ? `<div class="missed panel"><h3>📝 যেগুলো প্রথমবারে ভুল হয়েছিল</h3><ul>${missed.map((c) => `<li><b>${md(c.q)}</b><br>${md(c.explain)}</li>`).join('')}</ul></div>` : ''}
            <div class="acts">
              ${data.boss ? `<a class="btn" href="${data.boss.href}">🐉 ${data.boss.title}</a>` : ''}
              ${data.next ? `<a class="btn ${data.boss ? 'ghost' : ''}" href="${data.next.href}">পরের পাঠ: ${data.next.title} →</a>` : ''}
              <button class="btn ghost" id="again">🔁 আবার খেলো</button>
              <a class="btn ghost" href="${data.home}#board">🗺️ রোডম্যাপে ফিরে যাও</a>
            </div>
          </div></div>`;
        layer.scrollTop = 0;
        document.getElementById('again')!.onclick = () => start();
        document.getElementById('done-chip')!.hidden = false;
        if (xp > 0) toast(`⚡ +${bn(xp)} XP`, 'চালিয়ে যাও!');
      },
    });
  }
  document.querySelectorAll<HTMLElement>('[data-start]').forEach((b) => b.addEventListener('click', () => start(b.dataset.start)));
  if (location.hash === '#play') start('play');
  if (location.hash === '#quiz') start('quiz');
</script>
