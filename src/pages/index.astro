---
import Base from '../layouts/Base.astro';
import { courses } from '../data/courses';
import { getLessons, bnN, baseUrl } from '../data/course';
import { icon } from '../scripts/icons';

const base = baseUrl();
const cards = await Promise.all(
  courses.map(async (c) => {
    const lessons = c.status === 'live' ? await getLessons(c.id) : [];
    return { ...c, count: lessons.length, minutes: lessons.reduce((n, l) => n + l.minutes, 0), keys: lessons.map((l) => l.key), first: lessons[0]?.slug };
  }),
);
const rust = cards.find((c) => c.id === 'rust')!;
const siteUrl = new URL(base, Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Rust বাংলা', url: siteUrl, inLanguage: 'bn' },
  { '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: 'Rust বাংলা', url: siteUrl,
    logo: new URL(base + 'logo-mark-256.png', Astro.site).href, sameAs: ['https://www.youtube.com/@RustBangla'] },
];
---
<Base nav="courses" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">ফ্রি · লগইন লাগে না</span>
        <h1>প্রোগ্রামিং শেখো <em>করে করে</em>, বাংলায়।</h1>
        <p>ছোট ছোট পাঠ, প্রতিটা ধাপে প্রশ্ন, ব্রাউজারেই কোড চালাও। শুরু হচ্ছে Rust দিয়ে, শূন্য থেকে Advanced।</p>
        <div class="cta">
          <a class="btn" id="go" href={`${base}rust/`}>Rust শুরু করো <Fragment set:html={icon('arrow', 18)} /></a>
          <a class="btn alt" href="#courses">সব কোর্স</a>
        </div>
      </div>
      <img class="hero-logo" src={base + 'logo-mark.png'} alt="Rust বাংলা" width="280" height="280" />
    </div>
  </section>

  <section class="section" id="courses">
    <div class="wrap">
      <h2>কোর্স</h2>
      <p class="muted">একটা বেছে নাও। অগ্রগতি নিজে থেকেই সেভ হবে।</p>
      <div class="courses" data-reveal>
        {cards.map((c) =>
          c.status === 'live' ? (
            <a class="ccard" href={`${base}${c.id}/`} style={`--cc:${c.color}`} data-keys={c.keys.join(',')}>
              <div class="band"><b>{c.title}</b></div>
              <div class="body">
                <h3>{c.tagline}</h3>
                <p>{c.description}</p>
                <div class="meta">
                  <span set:html={icon('book', 15) + ` ${bnN(c.count)}টা পাঠ`} />
                  <span set:html={icon('clock', 15) + ` ~${bnN(Math.round(c.minutes / 60))} ঘণ্টা`} />
                  <span class="cp"></span>
                </div>
                <div class="bar"><i></i></div>
              </div>
            </a>
          ) : (
            <div class="ccard soon" style={`--cc:${c.color}`}>
              <span class="chip">শীঘ্রই</span>
              <div class="band"><b>{c.title}</b></div>
              <div class="body">
                <h3>{c.tagline}</h3>
                <p>{c.description}</p>
                <div class="meta"><span set:html={icon('lock', 15) + ` ${c.level}`} /></div>
              </div>
            </div>
          ),
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>কীভাবে শিখবে</h2>
      <p class="muted">বই পড়ার মতো না, খেলার মতো।</p>
      <div class="steps" data-reveal>
        <div class="step"><div class="si" set:html={icon('cards', 22)} /><h3>ছোট কার্ড</h3><p>প্রতিটা পাঠ কয়েকটা ছোট কার্ডে ভাগ করা। একটা কার্ডে একটাই ধারণা।</p></div>
        <div class="step"><div class="si" set:html={icon('target', 22)} /><h3>করে দেখো</h3><p>প্রতি দুই কার্ড পরে প্রশ্ন: আউটপুট বলো, ভুল লাইন ধরো, কোড সাজাও।</p></div>
        <div class="step"><div class="si" set:html={icon('code', 22)} /><h3>কোড চালাও</h3><p>প্রতিটা উদাহরণ এডিট করে ব্রাউজারেই চালাতে পারো, কিছু ইনস্টল ছাড়াই।</p></div>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" id="home-data" set:html={JSON.stringify({ first: `${base}rust/${rust.first}/` })} />
</Base>

<script>
  import { load, bn } from '../scripts/store';
  const s = load();
  document.querySelectorAll<HTMLElement>('.ccard[data-keys]').forEach((c) => {
    const keys = c.dataset.keys!.split(',');
    const done = keys.filter((k) => s.lessons[k]).length;
    c.querySelector<HTMLElement>('.bar i')!.style.width = (done / keys.length) * 100 + '%';
    c.querySelector('.cp')!.textContent = done ? `${bn(done)}/${bn(keys.length)} শেষ` : '';
  });
  if (Object.keys(s.lessons).length) {
    const go = document.getElementById('go')!;
    go.firstChild!.textContent = 'চালিয়ে যাও ';
  }
</script>
