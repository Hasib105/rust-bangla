---
import '../styles/global.css';
import '../styles/game.css';
import { site } from '../data/parts';

interface Props { title?: string; description?: string; nav?: 'home' | 'profile' | 'exam' | 'docs' }
const { title, description = 'শূন্য থেকে Advanced Rust শেখো বাংলায়, খেলতে খেলতে। ৪০টা ছোট পাঠ, কুইজ, XP, ব্যাজ আর ফাইনাল পরীক্ষা। লগইন লাগে না, পুরোপুরি ফ্রি।', nav } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} | Rust বাংলা` : 'Rust বাংলা: খেলতে খেলতে Rust শেখো';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(base + 'og.png', Astro.site);
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + 'favicon.png'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <meta name="theme-color" content="#fdf7f1" />
    <script is:inline>
      try { if (localStorage.getItem('rb-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="bn_BD" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={base}><img src={base + 'logo-mark-256.png'} alt="Rust বাংলা লোগো" width="38" height="38" /><span>Rust <b>বাংলা</b></span></a>
        <nav class="nav">
          <a href={base} aria-current={nav === 'home' ? 'page' : undefined}>🗺️ রোডম্যাপ</a>
          <a href={base + 'docs/'} aria-current={nav === 'docs' ? 'page' : undefined}>📚 ডকস</a>
          <a href={base + 'exam/'} aria-current={nav === 'exam' ? 'page' : undefined}>🎓 পরীক্ষা</a>
          <a href={base + 'profile/'} aria-current={nav === 'profile' ? 'page' : undefined}>🏅 প্রোফাইল</a>
        </nav>
        <div class="pills">
          <a class="pill fire" href={base + 'profile/'} title="টানা কত দিন শিখছো">🔥 <span data-stat="streak">০</span></a>
          <a class="pill xp" href={base + 'profile/'} title="মোট XP">⚡ <span data-stat="xp">০</span></a>
          <button class="icon-btn" data-theme-toggle title="লাইট/ডার্ক মোড" aria-label="লাইট/ডার্ক মোড">🌙</button>
          <button class="icon-btn" data-sound title="শব্দ চালু/বন্ধ" aria-label="শব্দ চালু/বন্ধ">🔊</button>
          <a class="pill yt-btn" href={site.youtube} target="_blank" rel="noopener" title="Rust Bangla YouTube">▶<span> YouTube</span></a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <img src={base + 'logo-mark-256.png'} alt="" width="44" height="44" />
        <div>
          <b>Rust বাংলা</b>: বাংলায় সবার জন্য ফ্রি Rust কোর্স। তোমার অগ্রগতি শুধু এই ব্রাউজারে সেভ থাকে।<br />
          <a href={site.youtube} target="_blank" rel="noopener">YouTube</a> ·
          <a href={site.playlist} target="_blank" rel="noopener">ভিডিও প্লেলিস্ট</a> ·
          <a href={site.facebook} target="_blank" rel="noopener">Facebook</a> ·
          <a href={base + 'docs/'}>ডকস</a>
        </div>
      </div>
    </footer>
    <nav class="bottomnav" aria-label="মোবাইল মেনু">
      <a href={base}><b>🗺️</b>রোডম্যাপ</a>
      <a href={base + 'docs/'}><b>📚</b>ডকস</a>
      <a href={base + 'exam/'}><b>🎓</b>পরীক্ষা</a>
      <a href={base + 'profile/'}><b>🏅</b>প্রোফাইল</a>
    </nav>
    <div id="toasts"></div>
    <script>
      import { initChrome } from '../scripts/ui';
      initChrome();
    </script>
  </body>
</html>
