---
import '../styles/global.css';
import { site } from '../data/courses';
import { icon } from '../scripts/icons';

interface Props { title?: string; description?: string; nav?: 'courses' | 'profile'; noindex?: boolean; jsonLd?: object | object[]; ogType?: string }
const { title, description = 'বাংলায় Rust প্রোগ্রামিং শেখো, শূন্য থেকে Advanced। ছোট পাঠ, প্রতিটা ধাপে প্রশ্ন, ব্রাউজারেই কোড চালাও। পুরোপুরি ফ্রি।', nav, noindex = false, jsonLd, ogType = 'website' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} | Rust বাংলা` : 'Rust বাংলা: বাংলায় Rust প্রোগ্রামিং শেখো (ফ্রি কোর্স)';
const gsv = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(base + 'og.png', Astro.site);
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {gsv && <meta name="google-site-verification" content={gsv} />}
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />
    <link rel="icon" href={base + 'favicon.png'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try { if (localStorage.getItem('rb-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Rust বাংলা" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="bn_BD" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={base}><img src={base + 'logo-mark-256.png'} alt="Rust বাংলা" width="34" height="34" /><span>Rust বাংলা</span></a>
        <nav class="nav">
          <a href={base} aria-current={nav === 'courses' ? 'page' : undefined}><Fragment set:html={icon('grid', 17)} />কোর্স</a>
          <a href={base + 'profile/'} aria-current={nav === 'profile' ? 'page' : undefined}><Fragment set:html={icon('user', 17)} />প্রোফাইল</a>
        </nav>
        <div class="right">
          <a class="pill fire" href={base + 'profile/'} title="টানা কত দিন শিখছো"><Fragment set:html={icon('flame', 16)} /><span data-stat="streak">০</span></a>
          <a class="pill xp" href={base + 'profile/'} title="মোট XP"><Fragment set:html={icon('bolt', 16)} /><span data-stat="xp">০</span></a>
          <span data-account class="acct-slot"></span>
          <button class="iconbtn" data-theme-toggle title="লাইট/ডার্ক" aria-label="লাইট/ডার্ক মোড"></button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <img src={base + 'logo-mark-256.png'} alt="" width="32" height="32" />
        <span>Rust বাংলা: বাংলায় সবার জন্য ফ্রি প্রোগ্রামিং কোর্স। GitHub দিয়ে লগইন করলে অগ্রগতি আর সার্টিফিকেট অ্যাকাউন্টে সেভ থাকে।</span>
        <a href={site.youtube} target="_blank" rel="noopener">YouTube</a>
      </div>
    </footer>
    <nav class="bottomnav" aria-label="মেনু">
      <a href={base} aria-current={nav === 'courses' ? 'page' : undefined}><Fragment set:html={icon('grid', 20)} />কোর্স</a>
      <a href={base + 'profile/'} aria-current={nav === 'profile' ? 'page' : undefined}><Fragment set:html={icon('user', 20)} />প্রোফাইল</a>
    </nav>
    <div id="toasts"></div>
    <script>
      import { initChrome } from '../scripts/ui';
      import '../scripts/account';
      initChrome();
    </script>
  </body>
</html>
