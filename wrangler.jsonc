{
  // Cloudflare Workers config. Deploy: npm run deploy (see README "Deploy to Cloudflare").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rust-bangla",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rust-bangla",
      // fill in after: npx wrangler d1 create rust-bangla
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (npx wrangler secret put NAME): BETTER_AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
  // Optional var: BETTER_AUTH_URL (defaults to the request origin)
}
